# Kopirati u .env (cp .env.example .env). .env se ne commit-uje.

PARKING_DB_USER=sep
PARKING_DB_PASSWORD=sep
PARKING_DB_PORT=5433

PSP_DB_USER=sep
PSP_DB_PASSWORD=sep
PSP_DB_PORT=5434

BANK_DB_USER=sep
BANK_DB_PASSWORD=sep
BANK_DB_PORT=5435

RABBITMQ_USER=sep
RABBITMQ_PASSWORD=sep

# PSP portal (psp-service). Prazno = razvojne vrednosti iz docker-compose.yml.
# U produkciji OBAVEZNO postaviti: JWT tajna (min. 32 znaka), AES kljuc (base64, 32 bajta).
PSP_JWT_SECRET=
PSP_ENCRYPTION_KEY=
PSP_SUPER_ADMIN_EMAIL=superadmin@sep.rs
PSP_SUPER_ADMIN_PASSWORD=
PSP_DEMO_DATA_ENABLED=true
# Javna adresa checkout stranice i HMAC tajna za plugin-ove (prazno = razvojne vrednosti)
PSP_CHECKOUT_BASE_URL=
PSP_PLUGIN_SHARED_SECRET=

# Banka i card plugin (prazno = razvojne vrednosti iz docker-compose.yml)
# BANK_PSP_HMAC_SECRET deli banka sa card plugin-om; kljucevi kartica: AES (base64, 32 bajta) i HMAC (min. 32 znaka)
BANK_PAYMENT_PAGE_URL=
BANK_PSP_HMAC_SECRET=
BANK_CARD_ENCRYPTION_KEY=
BANK_CARD_TOKEN_KEY=
BANK_DEMO_DATA_ENABLED=true
